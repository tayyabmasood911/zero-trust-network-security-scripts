#!/usr/sbin/nft -f
# ==============================================================================
# Enterprise Zero Trust Strict Default-Deny Nftables Ruleset
# Microsegmentation, stateful conntrack inspection, rate-limited admin ingress.
# ==============================================================================

flush ruleset

table inet filter {
    # Rate limit administrative connections (anti-bruteforce)
    set ssh_meter {
        type ipv4_addr
        flags dynamic
        timeout 60s
    }

    chain input {
        type filter hook input priority 0; policy drop;

        # 1. Accept localhost loopback traffic unconditionally
        iifname "lo" accept

        # 2. Drop invalid connection states immediately
        ct state invalid log prefix "[NFT-INVALID-DROP]: " drop

        # 3. Accept established and related connections (stateful conntrack)
        ct state { established, related } accept

        # 4. ICMP / Ping (Strict rate limiting)
        ip protocol icmp icmp type { echo-request, echo-reply, destination-unreachable, time-exceeded } limit rate 5/second accept

        # 5. Rate-limited administrative SSH (Port 22)
        tcp dport 22 ct state new update @ssh_meter { ip saddr limit rate 3/minute } accept
        tcp dport 22 log prefix "[NFT-SSH-RATE-LIMIT]: " drop

        # 6. Zero Trust Mutual TLS Service Port (Port 8443)
        tcp dport 8443 ct state new accept

        # 7. SPIRE Agent & Node Attestation Port (Port 8081)
        tcp dport 8081 ct state new accept

        # 8. Log and drop all unauthorized ingress traffic
        log prefix "[NFT-INGRESS-DENIED]: " drop
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
        log prefix "[NFT-FORWARD-DENIED]: " drop
    }

    chain output {
        type filter hook output priority 0; policy drop;

        # 1. Loopback egress
        oifname "lo" accept

        # 2. Allow established / related responses
        ct state { established, related } accept

        # 3. DNS resolution (UDP & TCP Port 53)
        udp dport 53 accept
        tcp dport 53 accept

        # 4. Outbound NTP Time Synchronization (UDP Port 123)
        udp dport 123 accept

        # 5. Outbound mTLS & HTTPS API Traffic (TCP 443 & 8443)
        tcp dport { 443, 8443 } ct state new accept

        # 6. SPIRE Upstream Server Egress (Port 8081)
        tcp dport 8081 ct state new accept

        # 7. Log and drop all unauthorized egress packets
        log prefix "[NFT-EGRESS-DENIED]: " drop
    }
}
